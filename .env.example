# Copy to .env and fill in real values. .env is gitignored - never commit it.

POSTGRES_PASSWORD=changeme

# One block per managed Mac, numbered from 1 with no gaps. Each SSH_TARGET
# is an alias defined in the mounted ./secrets/ssh/config (one config, shared
# by every host block below) so no real hostname needs to appear here either
# (see CONFIG.md). MODELS is a comma-separated allowlist - leave blank to use
# the built-in default three-model set.
DARKBLOOM_HOST_1_SSH_TARGET=my-darkbloom-host-1
DARKBLOOM_HOST_1_LABEL=host-1
DARKBLOOM_HOST_1_SPEC=Apple M3 Max
DARKBLOOM_HOST_1_MODELS=

# Leave every DARKBLOOM_HOST_2_* value blank (or delete the block) to run
# single-host. A second host does not need the same model allowlist as the
# first - each Mac only lists models it has actually downloaded.
DARKBLOOM_HOST_2_SSH_TARGET=
DARKBLOOM_HOST_2_LABEL=host-2
DARKBLOOM_HOST_2_SPEC=Apple M1 Max
DARKBLOOM_HOST_2_MODELS=

# Directory holding one SSH config, one identity file, and known_hosts
# covering every host block above, mounted read-only at /home/appuser/.ssh.
# chmod 600 the key file before mounting.
DARKBLOOM_SSH_DIR=./secrets/ssh

# Safety default: leave this false until you have watched OBSERVE mode
# recommend correct switches for a while. See CONFIG.md guardrails.
FLEET_LIVE_EXECUTION=false

POLL_INTERVAL_SECONDS=60
FLEET_DASHBOARD_PORT=8080
