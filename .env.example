# Copy to .env and fill in real values. .env is gitignored - never commit it.

POSTGRES_PASSWORD=changeme

# SSH alias or user@host for the managed darkbloom host. Define it as an
# alias in the mounted ./secrets/ssh/config so no real hostname needs to
# appear here either (see CONFIG.md).
DARKBLOOM_SSH_TARGET=my-darkbloom-host

# Directory holding config, an identity file, and known_hosts for that SSH
# target, mounted read-only into the container at /home/appuser/.ssh.
# chmod 600 the key file before mounting.
DARKBLOOM_SSH_DIR=./secrets/ssh

DARKBLOOM_HOST_LABEL=host-1
DARKBLOOM_HOST_SPEC=Apple M3 Max

# Safety default: leave this false until you have watched OBSERVE mode
# recommend correct switches for a while. See CONFIG.md guardrails.
FLEET_LIVE_EXECUTION=false

POLL_INTERVAL_SECONDS=60
FLEET_DASHBOARD_PORT=8080
